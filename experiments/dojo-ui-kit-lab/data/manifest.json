{
  "schemaVersion": "1.0.0",
  "kit": "ADHD Dojo Original UI Kit",
  "version": "0.1.0",
  "artDirection": {
    "name": "Indigo Lacquer / Warm Washi",
    "palette": {
      "indigo": "#0c2230",
      "lacquer": "#152e3f",
      "bronze": "#d4ad6e",
      "vermilion": "#aa4843",
      "washi": "#f2dfb6",
      "jade": "#92b4a9"
    },
    "principles": [
      "Original editable SVG illustrations",
      "Decorative art never carries essential text alone",
      "Minimum 44px hit targets",
      "Separate cosmetic skill effects from real learning records",
      "Meaningful interaction with return/navigation controls"
    ]
  },
  "sourcePolicy": {
    "productionAssets": "Original project artwork made for the Dojo, not traced from reference packs.",
    "references": [
      {
        "name": "CraftPix basic pixel UI",
        "role": "button/window inventories and state organization",
        "url": "https://craftpix.net/freebies/free-basic-pixel-art-ui-for-rpg/"
      },
      {
        "name": "CraftPix animated magic book",
        "role": "codex/page-opening interaction conventions",
        "url": "https://craftpix.net/freebies/free-animated-magic-book-pixel-art-asset-pack/"
      },
      {
        "name": "CraftPix monk and swordsman skills",
        "role": "skill icon taxonomy and visual storytelling",
        "url": "https://craftpix.net/freebies/free-monk-skills-icon-pack/"
      },
      {
        "name": "CraftPix top-down roads",
        "role": "map tile organization; no road sprites used",
        "url": "https://craftpix.net/freebies/free-path-and-road-top-down-pixel-tileset/"
      },
      {
        "name": "CraftPix samurai sprites",
        "role": "animation states and sprite sheet conventions",
        "url": "https://craftpix.net/freebies/free-samurai-pixel-art-sprite-sheets/"
      },
      {
        "name": "EAST Free Sample",
        "role": "shared scale and scene layering, no EAST files copied to this kit",
        "url": "https://mmorwynn.itch.io/east-free-sample"
      }
    ],
    "copyright": "All files under this kit assets/ directory are original project artwork. Reference ZIP artwork is not redistributed in this kit."
  },
